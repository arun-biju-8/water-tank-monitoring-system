# ==============================================================================
# TankPulse Water Tank Monitoring System — Backend Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit your actual .env file or production secrets to Git.
# ==============================================================================

# Server Environment Mode
# Set to 'production' on Render. In production, dev authentication bypasses are permanently disabled.
ENVIRONMENT=production

# Server Binding
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Connection String
# On Render: Use the 'Internal Database URL' (or 'External Database URL' if connecting externally).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_secure_password@dpg-xxxxxxxxxxxxxxxxxxxx-a.oregon-postgres.render.com/water_tank_db?sslmode=require

# ==============================================================================
# Authentication & Access Control
# ==============================================================================

# Secret passphrase required by web dashboard operators to issue buzzer silence commands.
# Operators enter this in the dashboard Settings modal.
# Required in production; missing token causes command endpoints to return HTTP 503.
DASHBOARD_CONTROL_TOKEN=change_this_to_a_secure_dashboard_operator_token

# Secret pre-shared key required by the ESP32 hardware to poll and acknowledge commands.
# Must match 'deviceApiKey' in esp32/secrets.h on the physical microcontroller.
# Required in production; missing key causes hardware endpoints to return HTTP 503.
ESP32_API_KEY=change_this_to_a_secure_esp32_device_api_key

# Command Time-To-Live (seconds)
# Stale commands older than this duration are automatically expired to prevent unexpected buzzer silencing.
# Default: 120
COMMAND_TTL_SECONDS=120

# Development Auth Bypass (Strictly blocked in production and on Render)
ALLOW_INSECURE_DEV_AUTH=false
