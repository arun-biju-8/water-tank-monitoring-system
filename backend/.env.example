# Render PostgreSQL Database URL
# For local development outside of Render, use the 'External Database URL' from your Render database dashboard.
# Format: postgresql://<username>:<password>@<hostname>.render.com/<database_name>?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@dpg-xxxxxxxxxxxxxxxxxxxx-a.oregon-postgres.render.com/your_database_name?sslmode=require

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
